@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap');
:root{--ink:#17312d;--muted:#6b817b;--cream:#f7f7f0;--paper:#fff;--mint:#d8f4dc;--lime:#c5ed5d;--coral:#ff8c73;--line:#dfe7df;--shadow:0 20px 45px rgba(23,49,45,.08)}*{box-sizing:border-box}body{margin:0;background:var(--cream);color:var(--ink);font-family:Manrope,system-ui,sans-serif}button,input,select{font:inherit}.shell{max-width:1120px;margin:auto;padding:34px 28px 26px}.hero{display:flex;gap:20px;align-items:flex-start;padding:22px 0 38px}.brand-mark{display:grid;place-items:center;width:52px;height:52px;border-radius:16px;background:var(--ink);color:var(--lime);font-weight:800;letter-spacing:-1px}.eyebrow{margin:0 0 10px;color:#739077;font:500 12px 'DM Mono',monospace;letter-spacing:.1em;text-transform:uppercase}h1,h2,p{margin-top:0}h1{font-size:clamp(38px,5vw,68px);line-height:1.02;letter-spacing:-.065em;margin-bottom:16px}h1 em{font-style:normal;color:#7d9a78}h2{font-size:23px;letter-spacing:-.04em;margin-bottom:0}.hero-copy{max-width:540px;color:var(--muted);font-size:16px;line-height:1.6}.finder-card,.result-card,.map-card{background:var(--paper);border:1px solid var(--line);border-radius:24px;box-shadow:var(--shadow)}.finder-card{padding:26px;margin-bottom:22px}.card-top{display:flex;justify-content:space-between;align-items:flex-start;gap:14px}.safe-chip,.location-pill{background:var(--mint);color:#477051;border-radius:999px;padding:8px 11px;font-size:12px;font-weight:700;white-space:nowrap}.finder-card form{display:grid;grid-template-columns:1.15fr 1.15fr .8fr;gap:10px;align-items:end;margin-top:24px}.finder-card label{font-size:12px;font-weight:800;color:var(--muted);grid-row:1}.finder-card input,.finder-card select{width:100%;border:1px solid var(--line);background:#fbfcf7;color:var(--ink);border-radius:12px;padding:14px 15px;outline:none;grid-row:2}.finder-card input:focus,.finder-card select:focus{border-color:#9fc263;box-shadow:0 0 0 3px #c5ed5d55}button{cursor:pointer;border:0}.finder-card button{grid-row:2;background:var(--ink);color:#fff;border-radius:12px;padding:14px;font-weight:800;transition:.2s}.finder-card button:hover{background:#2e544b;transform:translateY(-1px)}button:disabled{cursor:wait;opacity:.6;transform:none}.finder-card button span{color:var(--lime);font-size:20px;margin-left:7px}.status{min-height:18px;margin:14px 0 0;color:var(--muted);font-size:13px}.content-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:22px}.result-card{min-height:310px;padding:26px}.empty-state{display:grid;place-items:start;align-content:center;min-height:255px;color:var(--muted)}.big-arrow{font-size:54px;color:var(--coral);line-height:1;margin-bottom:17px}.empty-state h2{color:var(--ink);max-width:300px}.empty-state p{margin:10px 0 0}.result-heading{display:flex;justify-content:space-between;gap:15px;border-bottom:1px solid var(--line);padding-bottom:20px}.result-heading h2{margin-top:3px}.steps{display:grid;gap:12px;padding:20px 0 5px 30px;margin:0}.steps li{padding-left:4px;line-height:1.5}.steps li::marker{font-weight:800;color:#8aa73f}.ai-note{display:flex;gap:10px;background:#f3f8e6;border-radius:13px;padding:13px 15px;margin-top:20px}.ai-note p{margin:0;font-size:13px;line-height:1.5}.ai-badge{display:inline-block;align-self:flex-start;background:var(--lime);color:#3d4f17;border-radius:6px;padding:4px 7px;font:500 10px 'DM Mono',monospace;white-space:nowrap;text-transform:uppercase}.loading{color:var(--muted);padding-top:30px}.error-card{background:#fff1ec;border:1px solid #ffd4c8;border-radius:13px;padding:16px;color:#873e2f;line-height:1.5}.error-card p{margin:6px 0 0;font-size:13px}.difference{display:flex;gap:12px;align-items:flex-start;padding:18px 4px;color:var(--muted);font-size:13px;line-height:1.5}.difference p{margin:2px 0 0}.difference strong{color:var(--ink)}.map-card{padding:24px}.map-key{color:var(--muted);font-size:12px}.map-key i{display:inline-block;width:8px;height:8px;background:var(--coral);border-radius:50%;margin-right:4px}.map{display:grid;gap:12px;margin-top:24px}.building{background:#f0f5e6;border:1px solid #dce8ca;border-radius:14px;padding:13px}.building.green{background:#e7f5ec;border-color:#cbe7d3}.building-label{font:500 10px 'DM Mono',monospace;color:#77916a;letter-spacing:.08em;margin-bottom:10px}.floor{display:flex;align-items:center;gap:8px;padding:8px;border-top:1px dashed #cbd9c5}.floor span:first-child{font:500 10px 'DM Mono',monospace;color:#91a18a;width:18px}.floor button{background:#fff;border:1px solid #c9d6c4;border-radius:8px;padding:8px 10px;color:var(--ink);font-size:12px;font-weight:800}.floor button:hover,.floor button.selected{background:var(--coral);border-color:var(--coral);color:#fff}.floor .hall{font-size:11px;color:#91a18a;margin-left:auto}.map-help{font-size:12px;color:var(--muted);margin:15px 0 0}footer{display:flex;justify-content:space-between;color:#9ba9a1;font:500 10px 'DM Mono',monospace;text-transform:uppercase;padding:28px 3px 0}@media(max-width:760px){.shell{padding:22px 16px}.hero{padding-bottom:26px}.finder-card form,.content-grid{grid-template-columns:1fr}.finder-card label{grid-row:auto}.finder-card input,.finder-card select,.finder-card button{grid-row:auto}.result-heading{display:block}.location-pill{display:inline-block;margin-top:12px}.safe-chip{font-size:10px}footer{gap:10px;flex-direction:column}}
