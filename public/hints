.hint-wrap{position:relative;display:inline-flex;margin-left:4px;vertical-align:middle}
.hint-button{display:grid;place-items:center;width:17px;height:17px;padding:0;background:var(--mint);color:#477051;border-radius:50%;font-size:11px;font-weight:800;line-height:1}
.hint-button:hover,.hint-button:focus{background:var(--lime);outline:2px solid #9fc263;outline-offset:2px}
.hint-tooltip{position:absolute;left:24px;bottom:-5px;z-index:2;width:190px;padding:9px 11px;border:1px solid var(--line);border-radius:9px;background:var(--ink);color:#fff;font-size:11px;font-weight:500;line-height:1.4;opacity:0;pointer-events:none;transform:translateY(4px);transition:opacity .15s,transform .15s}
.hint-wrap:hover .hint-tooltip,.hint-button:focus + .hint-tooltip{opacity:1;transform:translateY(0)}
